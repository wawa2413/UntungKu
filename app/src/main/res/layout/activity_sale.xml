<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5EBE6"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header / Judul -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kasir Penjualan"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#4A3B32"
        android:layout_marginBottom="20dp"/>

    <!-- Kartu Pilihan Produk -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pilih Produk Terjual"
                android:textSize="13sp"
                android:textColor="#8D7B68"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <Spinner
                android:id="@+id/spinnerProducts"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@android:drawable/editbox_background_normal"
                android:padding="8dp"/>

            <TextView
                android:id="@+id/tvHargaSatuan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pilih produk di atas..."
                android:textSize="13sp"
                android:textColor="#4A3B32"
                android:layout_marginTop="12dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Kartu Jumlah Pembelian (Qty) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jumlah Pembelian (Qty)"
                android:textSize="13sp"
                android:textColor="#8D7B68"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnMinus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="-"
                    android:textSize="18sp"
                    android:backgroundTint="#8D7B68"
                    android:textColor="#FFFFFF"
                    android:padding="0dp"/>

                <EditText
                    android:id="@+id/etJumlahJual"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:hint="1"
                    android:text="1"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#4A3B32"
                    android:inputType="number"
                    android:background="@null"/>

                <Button
                    android:id="@+id/btnPlus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="+"
                    android:textSize="18sp"
                    android:backgroundTint="#4A3B32"
                    android:textColor="#FFFFFF"
                    android:padding="0dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Ringkasan Total Pembayaran -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Total Pembayaran"
            android:textSize="15sp"
            android:textColor="#7A685D"/>

        <TextView
            android:id="@+id/tvTotalBayar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 0"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#C86D51"/>
    </LinearLayout>

    <!-- Tombol Simpan Transaksi -->
    <Button
        android:id="@+id/btnSimpanPenjualan"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Simpan Transaksi Kasir"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#4A3B32"
        android:textColor="#FFFFFF"
        app:cornerRadius="14dp"/>

</LinearLayout>