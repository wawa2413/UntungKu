<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5EBE6"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Judul Aplikasi -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UntungKu"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#4A3B32"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Catat Penjualan &amp; Hitung Keuntungan Usahamu"
        android:textSize="14sp"
        android:textColor="#7A685D"
        android:layout_marginBottom="32dp"
        android:gravity="center"/>

    <!-- Input Email -->
    <EditText
        android:id="@+id/etEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Email"
        android:textColor="#4A3B32"
        android:textColorHint="#9E8A7E"
        android:inputType="textEmailAddress"
        android:background="@android:drawable/editbox_background_normal"
        android:padding="16dp"
        android:layout_marginBottom="16dp"/>

    <!-- Input Password -->
    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Password"
        android:textColor="#4A3B32"
        android:textColorHint="#9E8A7E"
        android:inputType="textPassword"
        android:background="@android:drawable/editbox_background_normal"
        android:padding="16dp"
        android:layout_marginBottom="24dp"/>

    <!-- Tombol Login -->
    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Masuk"
        android:backgroundTint="#4A3B32"
        android:textColor="#FFFFFF"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <!-- Tombol Pindah ke Register -->
    <TextView
        android:id="@+id/tvToRegister"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Belum punya akun? Daftar di sini"
        android:textColor="#4A3B32"
        android:textSize="14sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"/>

</LinearLayout>