<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F5EBE6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tambah Produk Baru"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#4A3B32"
            android:layout_marginBottom="16dp"/>

        <!-- Kotak Pratinjau Foto & Tombol Pilih -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/ivDialogPreview"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:scaleType="centerCrop"
                android:background="#EFEBE9"
                android:src="@android:drawable/ic_menu_gallery"
                android:layout_marginRight="12dp"/>

            <Button
                android:id="@+id/btnPilihFoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pilih Foto dari Galeri"
                android:backgroundTint="#8D7B68"
                android:textColor="#FFFFFF"
                android:padding="12dp"/>
        </LinearLayout>

        <EditText
            android:id="@+id/etNamaProduk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nama Produk"
            android:textColor="#4A3B32"
            android:textColorHint="#9E8A7E"
            android:inputType="textPersonName"
            android:background="@android:drawable/editbox_background_normal"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etHargaModal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Harga Modal (Rp)"
            android:textColor="#4A3B32"
            android:textColorHint="#9E8A7E"
            android:inputType="numberDecimal"
            android:background="@android:drawable/editbox_background_normal"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etHargaJual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Harga Jual (Rp)"
            android:textColor="#4A3B32"
            android:textColorHint="#9E8A7E"
            android:inputType="numberDecimal"
            android:background="@android:drawable/editbox_background_normal"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etStok"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Jumlah Stok"
            android:textColor="#4A3B32"
            android:textColorHint="#9E8A7E"
            android:inputType="number"
            android:background="@android:drawable/editbox_background_normal"
            android:padding="12dp"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnSimpanProduk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simpan Produk"
            android:backgroundTint="#4A3B32"
            android:textColor="#FFFFFF"
            android:padding="14dp"/>

    </LinearLayout>
</ScrollView>